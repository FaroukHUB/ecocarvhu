# EcocarVHU — variables d'environnement (aucun secret ici).
# Copier en .env.local pour le développement local.

# --- Publication -----------------------------------------------------------
# production | preview | development
# Sans valeur, une build est traitée comme "preview" (noindex partout).
SITE_ENV=development
# Domaine définitif en https, sans slash final. Requis pour l'indexation,
# les canonicals, le sitemap et le JSON-LD. Ne jamais mettre localhost en production.
NEXT_PUBLIC_SITE_URL=

# Protection optionnelle de la prévisualisation (Basic Auth), hors production.
# Format : utilisateur:motdepasse — à définir dans l'hébergeur, pas ici.
PREVIEW_BASIC_AUTH=

# --- Formulaires -----------------------------------------------------------
# resend : envoi réel par e-mail via l'API Resend
# demo   : autorisé UNIQUEMENT avec SITE_ENV=development (rien n'est transmis)
FORM_TRANSPORT=demo
# Clé API Resend (secret, côté serveur uniquement — à définir dans l'hébergeur)
RESEND_API_KEY=
# Destinataire(s) des demandes, séparés par des virgules
FORM_TO_EMAIL=
# Expéditeur sur un domaine vérifié chez Resend, ex. "EcocarVHU <demandes@domaine-verifie>"
FORM_FROM_EMAIL=
# Limites des photos (Mo). Par défaut 3 Mo/photo et 4 Mo/demande (compatible
# avec les hébergeurs qui plafonnent le corps des requêtes à ~4,5 Mo).
FORM_MAX_FILE_MB=3
FORM_MAX_TOTAL_MB=4

# --- Mesure (désactivée par défaut) ----------------------------------------
# "true" uniquement après choix d'un outil, configuration et gestion du consentement.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
