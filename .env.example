# EcocarVHU — variables d'environnement (aucun secret ici).
# Copier en .env.local pour le développement local.

# --- Publication -----------------------------------------------------------
# production | preview | development
# Sans valeur, une build est traitée comme "preview" (noindex partout).
SITE_ENV=development
# Domaine définitif en https, sans slash final. Requis pour l'indexation,
# les canonicals, le sitemap et le JSON-LD. Ne jamais mettre localhost en production.
NEXT_PUBLIC_SITE_URL=

# Protection optionnelle de la prévisualisation (Basic Auth), hors production.
# Format : utilisateur:motdepasse — à définir dans l'hébergeur, pas ici.
PREVIEW_BASIC_AUTH=

# --- Formulaires -----------------------------------------------------------
# brevo  : envoi réel par e-mail via l'API transactionnelle Brevo
# resend : envoi réel par e-mail via l'API Resend
# demo   : autorisé UNIQUEMENT avec SITE_ENV=development (rien n'est transmis)
FORM_TRANSPORT=demo
# Clé API Brevo (secret, côté serveur uniquement — à définir dans l'hébergeur)
BREVO_API_KEY=
# Clé API Resend (si FORM_TRANSPORT=resend)
RESEND_API_KEY=
# Destinataire(s) des demandes, séparés par des virgules
FORM_TO_EMAIL=
# Expéditeur sur un domaine vérifié chez Brevo ou Resend, ex. "EcocarVHU <demandes@domaine-verifie>"
FORM_FROM_EMAIL=
# Nom d'expéditeur (Brevo, facultatif — défaut : EcocarVHU)
FORM_FROM_NAME=
# Limites des photos (Mo). Par défaut 3 Mo/photo et 4 Mo/demande (compatible
# avec les hébergeurs qui plafonnent le corps des requêtes à ~4,5 Mo).
FORM_MAX_FILE_MB=3
FORM_MAX_TOTAL_MB=4

# --- Espace de gestion /admin (Supabase) ------------------------------------
# Sans ces variables, /admin répond 404 et les demandes ne partent que par e-mail.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Jeton de réception des demandes (table private.settings, clé ingest_token).
SUPABASE_INGEST_TOKEN=
# Jeton d'accès Vercel (Account Settings → Tokens), page Statistiques de l'admin.
VERCEL_ANALYTICS_TOKEN=

# Prospection : tâche quotidienne d'envoi des relances (Vercel Cron, en-tête Authorization: Bearer).
CRON_SECRET=
# Optionnel : rédaction des e-mails de prospection par l'IA (Claude). Sans clé, seuls les modèles sont proposés.
ANTHROPIC_API_KEY=

# Positions Google (Search Console) : clé JSON d'un compte de service (brute ou en base64),
# ajouté comme utilisateur « Restreint » de la propriété. GSC_SITE par défaut : sc-domain:ecocarvhu.fr
GSC_SERVICE_ACCOUNT=
GSC_SITE=
